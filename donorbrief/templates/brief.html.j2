{#- Styles follow docs/STYLE.md (IoG Brand Guide 2026). Inline styles and tables keep it email-safe. -#}
{%- set display = "Optima,'Optima nova',Candara,'Gill Sans','Segoe UI',sans-serif" -%}
{%- set body = "'DM Sans','Segoe UI',Arial,sans-serif" -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>{{ brief.subject }}</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap" rel="stylesheet">
</head>
<body style="margin:0;padding:0;background:#FBF8F2;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF8F2;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;font-family:{{ body }};color:#000000;">

  {#- Top bar -#}
  <tr><td style="background:#000000;padding:14px 28px;border-radius:3px 3px 0 0;">
    <div style="font-family:{{ body }};font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#C7E263;line-height:1.4;">Institute on Generosity</div>
    <div style="font-family:{{ body }};font-size:11.5px;color:#B5B3AE;line-height:1.4;">DonorBrief &middot; Week of {{ week_of }}</div>
  </td></tr>

  {#- Lime header -#}
  <tr><td style="background:#C7E263;padding:32px 28px 28px;">
    <div style="display:inline-block;background:#000000;color:#C7E263;font-family:{{ body }};font-size:9.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;padding:4px 8px;border-radius:3px;">Weekly briefing</div>
    <h1 style="font-family:{{ display }};font-weight:400;font-size:32px;line-height:1.15;margin:14px 0 0;color:#000000;">{{ brief.subject }}</h1>
  </td></tr>

  {#- Intro -#}
  <tr><td style="background:#FFFFFF;padding:24px 28px 4px;font-family:{{ body }};font-size:16px;line-height:1.55;color:#000000;">{{ brief.intro }}</td></tr>

  {#- In this issue: every category with its headlines, so readers can scan the week by topic -#}
  {% if sections|length > 1 %}
  <tr><td style="background:#FFFFFF;padding:20px 28px 4px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF8F2;border:1px solid #EBE7DF;border-radius:3px;">
      <tr><td style="padding:18px 20px 6px;font-family:{{ body }};font-size:10.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#000000;">In this issue</td></tr>
      {% for section in sections %}
      <tr><td style="padding:10px 20px {{ '18px' if loop.last else '4px' }};">
        <div style="font-family:{{ body }};font-size:10.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#42820F;line-height:1.4;">{{ '%02d'|format(loop.index) }} &middot; {{ section.title }} <span style="color:#8C8C8C;font-weight:400;">({{ section.entries|length }})</span></div>
        {% for e in section.entries %}
        <div style="font-family:{{ body }};font-size:13.5px;line-height:1.45;color:#000000;padding:4px 0 0 14px;text-indent:-10px;">&ndash;&nbsp;{{ e.headline }}</div>
        {% endfor %}
      </td></tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endif %}

  {% for section in sections %}
  {#- Category header: number, name and what it covers -#}
  <tr><td style="background:#FFFFFF;padding:32px 28px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr><td style="border-top:3px solid #000000;padding:12px 0 10px;border-bottom:1px solid #EBE7DF;">
        <div style="font-family:{{ body }};font-size:10.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#42820F;line-height:1.4;">{{ '%02d'|format(loop.index) }} &middot; {{ section.entries|length }} {{ "story" if section.entries|length == 1 else "stories" }}</div>
        <div style="font-family:{{ display }};font-weight:400;font-size:24px;line-height:1.25;color:#000000;margin:4px 0 0;">{{ section.title }}</div>
        {%- if section.description %}
        <div style="font-family:{{ body }};font-size:13px;line-height:1.5;color:#5E5E5E;margin:4px 0 0;">{{ section.description }}</div>
        {%- endif %}
      </td></tr>
    </table>
  </td></tr>
  {% for e in section.entries %}
  <tr><td style="background:#FFFFFF;padding:20px 28px 0;">
    <h2 style="font-family:{{ display }};font-weight:400;font-size:19px;line-height:1.3;margin:0 0 6px;"><a href="{{ e.url }}" style="color:#000000;text-decoration:none;">{{ e.headline }}</a></h2>
    <p style="font-family:{{ body }};font-size:14.5px;line-height:1.55;margin:0 0 6px;color:#000000;">{{ e.body }}</p>
    <div style="font-family:{{ body }};font-size:12px;color:#8C8C8C;"><a href="{{ e.url }}" style="color:#42820F;text-decoration:none;font-weight:700;">{{ e.source }} &rarr;</a></div>
  </td></tr>
  {% endfor %}
  {% endfor %}

  <tr><td style="background:#FFFFFF;padding:0 0 28px;border-radius:0 0 3px 3px;">&nbsp;</td></tr>

  {#- Footer -#}
  <tr><td style="padding:20px 28px;font-family:{{ body }};font-size:12px;line-height:1.5;color:#5E5E5E;">
    AI-drafted from public sources and reviewed by Institute on Generosity staff before sending.
    {%- if mailchimp %}
    {#- Mailchimp fills these in; it won't send a campaign without them. #}
    <br><br>You're receiving this because you subscribed to Institute on Generosity updates.
    <a href="*|UNSUB|*" style="color:#5E5E5E;">Unsubscribe</a> &middot; <a href="*|UPDATE_PROFILE|*" style="color:#5E5E5E;">Update preferences</a>
    <br>*|LIST:ADDRESSLINE|*
    {%- endif %}
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
