{#- Styles follow docs/STYLE.md (IoG Brand Guide 2026). Inline styles and tables keep it email-safe. -#}
{%- set display = "Optima,'Optima nova',Candara,'Gill Sans','Segoe UI',sans-serif" -%}
{%- set body = "'DM Sans','Segoe UI',Arial,sans-serif" -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>{{ brief.subject }}</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap" rel="stylesheet">
</head>
<body style="margin:0;padding:0;background:#FBF8F2;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF8F2;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;font-family:{{ body }};color:#000000;">

  {#- Top bar -#}
  <tr><td style="background:#000000;padding:14px 28px;border-radius:3px 3px 0 0;">
    <div style="font-family:{{ body }};font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#C7E263;line-height:1.4;">Institute on Generosity</div>
    <div style="font-family:{{ body }};font-size:11.5px;color:#B5B3AE;line-height:1.4;">DonorBrief &middot; Week of {{ week_of }}</div>
  </td></tr>

  {#- Lime header -#}
  <tr><td style="background:#C7E263;padding:32px 28px 28px;">
    <div style="display:inline-block;background:#000000;color:#C7E263;font-family:{{ body }};font-size:9.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;padding:4px 8px;border-radius:3px;">Weekly briefing</div>
    <h1 style="font-family:{{ display }};font-weight:400;font-size:32px;line-height:1.15;margin:14px 0 0;color:#000000;">{{ brief.subject }}</h1>
  </td></tr>

  {#- Intro -#}
  <tr><td style="background:#FFFFFF;padding:24px 28px 4px;font-family:{{ body }};font-size:16px;line-height:1.55;color:#000000;">{{ brief.intro }}</td></tr>

  {#- Reusable bits -#}
  {%- macro label(text, color="#42820F") -%}
  <div style="font-family:{{ body }};font-size:10.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:{{ color }};line-height:1.4;">{{ text }}</div>
  {%- endmacro -%}
  {%- macro part(number, title, note) -%}
  <tr><td style="background:#FFFFFF;padding:36px 28px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr><td style="border-top:3px solid #000000;padding:12px 0 10px;border-bottom:1px solid #EBE7DF;">
        {{ label(number) }}
        <div style="font-family:{{ display }};font-weight:400;font-size:24px;line-height:1.25;color:#000000;margin:4px 0 0;">{{ title }}</div>
        {%- if note %}<div style="font-family:{{ body }};font-size:13px;line-height:1.5;color:#5E5E5E;margin:4px 0 0;">{{ note }}</div>{% endif %}
      </td></tr>
    </table>
  </td></tr>
  {%- endmacro -%}
  {%- macro update_tag(e) -%}
  {%- if e.follow_up %}<span style="display:inline-block;background:#C7E263;color:#000000;font-family:{{ body }};font-size:9.5px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:2px 6px;border-radius:3px;vertical-align:middle;">Update</span> {% endif -%}
  {%- endmacro -%}
  {%- set top = brief.top or [] -%}
  {%- set trends = brief.trends or [] -%}
  {%- set n = namespace(part=0) -%}

  {#- In this issue -#}
  <tr><td style="background:#FFFFFF;padding:20px 28px 4px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF8F2;border:1px solid #EBE7DF;border-radius:3px;">
      <tr><td style="padding:18px 20px 4px;">{{ label("In this issue", "#000000") }}</td></tr>
      {%- if top %}
      <tr><td style="padding:10px 20px 4px;">
        {{ label("Top stories") }}
        {%- for e in top %}<div style="font-family:{{ body }};font-size:13.5px;line-height:1.45;color:#000000;padding:4px 0 0 14px;text-indent:-10px;">&ndash;&nbsp;{{ e.headline }}</div>{% endfor %}
      </td></tr>
      {%- endif %}
      {%- if trends %}
      <tr><td style="padding:10px 20px 4px;">
        {{ label("Trends to watch") }}
        {%- for t in trends %}<div style="font-family:{{ body }};font-size:13.5px;line-height:1.45;color:#000000;padding:4px 0 0 14px;text-indent:-10px;">&ndash;&nbsp;{{ t.title }}</div>{% endfor %}
      </td></tr>
      {%- endif %}
      {%- if sections %}
      <tr><td style="padding:10px 20px 18px;">
        {{ label("The week in brief") }}
        <div style="font-family:{{ body }};font-size:13.5px;line-height:1.6;color:#000000;padding:4px 0 0;">
          {%- for s in sections %}{{ s.title }} ({{ s.entries|length }}){% if not loop.last %} &middot; {% endif %}{% endfor %}
        </div>
      </td></tr>
      {%- endif %}
    </table>
  </td></tr>

  {#- 1. Top stories: the week's most consequential news, in full -#}
  {%- if top %}
  {%- set n.part = n.part + 1 %}
  {{ part('%02d'|format(n.part) ~ " · " ~ top|length ~ (" story" if top|length == 1 else " stories"), "Top stories", "The week's most consequential news.") }}
  {%- for e in top %}
  <tr><td style="background:#FFFFFF;padding:20px 28px 0;">
    {%- if e.section %}{{ label(e.section, "#8C8C8C") }}{% endif %}
    <h2 style="font-family:{{ display }};font-weight:400;font-size:21px;line-height:1.28;margin:4px 0 6px;">{{ update_tag(e) }}<a href="{{ e.url }}" style="color:#000000;text-decoration:none;">{{ e.headline }}</a></h2>
    <p style="font-family:{{ body }};font-size:15px;line-height:1.55;margin:0 0 6px;color:#000000;">{{ e.body }}</p>
    <div style="font-family:{{ body }};font-size:12px;"><a href="{{ e.url }}" style="color:#42820F;text-decoration:none;font-weight:700;">{{ e.source }} &rarr;</a></div>
  </td></tr>
  {%- endfor %}
  {%- endif %}

  {#- 2. Trends to watch: patterns building across weeks, with the stories behind them -#}
  {%- if trends %}
  {%- set n.part = n.part + 1 %}
  {{ part('%02d'|format(n.part) ~ " · " ~ trends|length ~ (" trend" if trends|length == 1 else " trends"), "Trends to watch", "Patterns building across several weeks of coverage.") }}
  {%- for t in trends %}
  <tr><td style="background:#FFFFFF;padding:20px 28px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF8F2;border-left:3px solid #C7E263;">
      <tr><td style="padding:16px 18px;">
        {{ label(t.stories ~ " stories over " ~ t.weeks ~ " weeks") }}
        <div style="font-family:{{ display }};font-weight:400;font-size:20px;line-height:1.28;color:#000000;margin:4px 0 6px;">{{ t.title }}</div>
        <p style="font-family:{{ body }};font-size:14.5px;line-height:1.55;margin:0 0 8px;color:#000000;">{{ t.body }}</p>
        {%- for s in t.evidence %}
        <div style="font-family:{{ body }};font-size:12.5px;line-height:1.45;padding:3px 0 0;"><a href="{{ s.url }}" style="color:#000000;text-decoration:underline;text-decoration-color:#C7E263;">{{ s.title }}</a> <span style="color:#8C8C8C;">&middot; {{ s.source }}</span></div>
        {%- endfor %}
      </td></tr>
    </table>
  </td></tr>
  {%- endfor %}
  {%- endif %}

  {#- 3. The week in brief: everything else, one line each, by category -#}
  {%- if sections %}
  {%- set n.part = n.part + 1 %}
  {{ part('%02d'|format(n.part) ~ " · the rest of the week", "The week in brief", "") }}
  {%- for section in sections %}
  <tr><td style="background:#FFFFFF;padding:20px 28px 0;">
    {{ label(section.title) }}
    {%- for e in section.entries %}
    <div style="font-family:{{ body }};font-size:14px;line-height:1.5;color:#000000;padding:8px 0 0;">{{ update_tag(e) }}<a href="{{ e.url }}" style="color:#000000;font-weight:700;text-decoration:none;">{{ e.headline }}{% if e.headline[-1:] not in '.?!' %}.{% endif %}</a> {{ e.body }} <a href="{{ e.url }}" style="color:#42820F;text-decoration:none;font-weight:700;font-size:12px;">{{ e.source }}&nbsp;&rarr;</a></div>
    {%- endfor %}
  </td></tr>
  {%- endfor %}
  {%- endif %}

  <tr><td style="background:#FFFFFF;padding:0 0 28px;border-radius:0 0 3px 3px;">&nbsp;</td></tr>

  {#- Footer -#}
  <tr><td style="padding:20px 28px;font-family:{{ body }};font-size:12px;line-height:1.5;color:#5E5E5E;">
    AI-drafted from public sources and reviewed by Institute on Generosity staff before sending.
    {%- if mailchimp %}
    {#- Mailchimp fills these in; it won't send a campaign without them. #}
    <br><br>You're receiving this because you subscribed to Institute on Generosity updates.
    <a href="*|UNSUB|*" style="color:#5E5E5E;">Unsubscribe</a> &middot; <a href="*|UPDATE_PROFILE|*" style="color:#5E5E5E;">Update preferences</a>
    <br>*|LIST:ADDRESSLINE|*
    {%- endif %}
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
