<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brief.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f2ee;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f2ee;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;font-family:Georgia,'Times New Roman',serif;color:#1f1f1f;">
  <tr><td style="padding:28px 32px 8px;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:#8a6d3b;">DonorBrief &middot; Institute on Generosity</div>
    <h1 style="font-size:24px;line-height:1.25;margin:8px 0 4px;">{{ brief.subject }}</h1>
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#666;">Week of {{ week_of }}</div>
  </td></tr>
  <tr><td style="padding:12px 32px 4px;font-size:16px;line-height:1.55;">{{ brief.intro }}</td></tr>
  {% for section in sections %}
  <tr><td style="padding:20px 32px 0;">
    <h2 style="font-family:Arial,Helvetica,sans-serif;font-size:14px;letter-spacing:1px;text-transform:uppercase;color:#8a6d3b;border-bottom:1px solid #e6e0d4;padding-bottom:6px;margin:0;">{{ section.title }}</h2>
  </td></tr>
  {% for e in section.entries %}
  <tr><td style="padding:14px 32px 0;">
    <h3 style="font-size:17px;line-height:1.3;margin:0 0 4px;"><a href="{{ e.url }}" style="color:#1f1f1f;text-decoration:none;">{{ e.headline }}</a></h3>
    <p style="font-size:15px;line-height:1.55;margin:0 0 4px;">{{ e.body }}</p>
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#888;"><a href="{{ e.url }}" style="color:#8a6d3b;">{{ e.source }}</a></div>
  </td></tr>
  {% endfor %}
  {% endfor %}
  <tr><td style="padding:28px 32px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#888;">
    AI-drafted from public sources and reviewed by Institute on Generosity staff before sending.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
