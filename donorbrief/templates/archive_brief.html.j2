{% extends "_archive_base.html.j2" %}
{% block title %}{{ brief.subject }} · DonorBrief{% endblock %}
{% block description %}{{ brief.intro|truncate(155) }}{% endblock %}
{% block nav %}<a href="../">All briefs</a>{% endblock %}
{% block style %}
.intro { font-size: 17px; margin: 32px 0 0; }
.toc { background: var(--white); border: 1px solid var(--rule); border-radius: 3px; padding: 20px 24px; margin: 28px 0 0; }
.toc ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px 32px; }
.toc li > .eyebrow { margin-top: 14px; }
.toc .eyebrow a { color: var(--green); }
.toc .n { color: var(--meta); font-weight: 400; }
.toc ul { list-style: none; margin: 6px 0 0; padding: 0; }
.toc ul li { font-size: 14px; line-height: 1.45; padding: 3px 0 3px 12px; text-indent: -12px; }
.toc ul a { color: var(--black); }
.toc ul li::before { content: "– "; }
.cat { border-top: 3px solid var(--black); margin: 48px 0 0; padding: 12px 0 12px; border-bottom: 1px solid var(--rule); scroll-margin-top: 16px; }
.cat .eyebrow { color: var(--green); }
.cat h2 { font-size: 26px; line-height: 1.2; margin: 4px 0 0; }
.cat p { margin: 4px 0 0; font-size: 14px; color: var(--quiet); }
.entry { padding: 22px 0 0; scroll-margin-top: 16px; }
.entry .kicker { color: var(--meta); }
.entry h3 { font-size: 21px; line-height: 1.28; margin: 4px 0 6px; }
.entry h3 a { color: var(--black); }
.entry p { margin: 0 0 6px; font-size: 15.5px; }
.src { font-size: 12.5px; font-weight: 700; }
.update { display: inline-block; background: var(--lime); color: var(--black); font-family: var(--font-body); font-size: 9.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; vertical-align: middle; margin-right: 4px; }
.trend { background: var(--white); border-left: 3px solid var(--lime); padding: 18px 20px; margin: 22px 0 0; scroll-margin-top: 16px; }
.trend .eyebrow { color: var(--green); }
.trend h3 { font-size: 21px; line-height: 1.28; margin: 4px 0 6px; }
.trend p { margin: 0 0 10px; font-size: 15.5px; }
.trend ul { list-style: none; margin: 0; padding: 0; }
.trend li { font-size: 13.5px; line-height: 1.45; padding: 3px 0; }
.trend li a { color: var(--black); text-decoration: underline; text-decoration-color: var(--lime); text-decoration-thickness: 2px; }
.trend li span { color: var(--meta); }
.takeaways { margin: 32px 0 0; }
.takeaways > .eyebrow { color: var(--black); }
.takeaways .sub { font-size: 13px; color: var(--meta); margin: 2px 0 8px; }
.takeaways ol { list-style: none; margin: 0; padding: 0; }
.takeaways li { display: grid; grid-template-columns: 34px 1fr; border-top: 1px solid var(--rule); padding: 14px 0 12px; }
.takeaways .num { width: 24px; height: 24px; line-height: 24px; text-align: center; background: var(--lime); border-radius: 3px; font-weight: 700; font-size: 13px; }
.takeaways .lead { font-size: 17px; line-height: 1.35; font-weight: 700; }
.takeaways .detail { margin: 4px 0 0; font-size: 15.5px; }
.takeaways .refs { margin: 4px 0 0; font-size: 12.5px; font-weight: 700; display: flex; flex-wrap: wrap; gap: 4px 14px; }
.chip { display: inline-block; background: var(--lime); color: var(--black); font-family: var(--font-body); font-size: 9.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; vertical-align: middle; margin-right: 4px; }
.lead-story { padding: 16px 0 2px; scroll-margin-top: 16px; }
.lead-story h3 { font-size: 21px; line-height: 1.28; margin: 4px 0 4px; }
.lead-story h3 a { color: var(--black); }
.lead-story p { margin: 0; font-size: 15.5px; }
.news-index { font-size: 13px; color: var(--quiet); margin: 10px 0 0; }
.group { margin: 26px 0 0; }
.group > .eyebrow { border-bottom: 1px solid var(--rule); padding-bottom: 6px; }
.group .eyebrow { color: var(--green); }
.brief-item { font-size: 15px; line-height: 1.5; padding: 10px 0 0; scroll-margin-top: 16px; }
.brief-item > a:first-of-type { color: var(--black); font-weight: 700; }
.pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--rule); font-size: 14px; }
.pager a { max-width: 48%; }
.pager .next { text-align: right; margin-left: auto; }
@media (max-width: 600px) { .toc ol { grid-template-columns: 1fr; } }
{% endblock %}
{% block content %}
{%- set takeaways = brief.takeaways or [] -%}
{%- set trends = brief.trends or [] -%}
{%- set legacy = not takeaways -%}
{%- macro chips(e) %}{% for n in e.takeaways or [] %}<span class="chip">Takeaway {{ n }}</span>{% endfor %}{% if e.follow_up %}<span class="chip">Update</span>{% endif %}{% endmacro -%}
<section class="hero">
  <div class="wrap">
    <span class="tag">Week of {{ brief.week_of }}</span>
    <h1>{{ brief.subject }}</h1>
  </div>
</section>
<main class="wrap">
  {% if legacy %}<p class="intro">{{ brief.intro }}</p>{% endif %}

  {% if takeaways %}
  <section class="takeaways" aria-label="Key takeaways">
    <div class="eyebrow">Key takeaways</div>
    <div class="sub">The week in 30 seconds. The stories behind each point are below.</div>
    <ol>
      {% for t in takeaways %}
      <li>
        <span class="num">{{ t.n }}</span>
        <div>
          <div class="lead">{{ t.lead }}</div>
          <p class="detail">{{ t.detail }}</p>
          <div class="refs">{% for st in t.stories %}<a href="#{{ st.anchor }}">{{ st.source }} &darr;</a>{% endfor %}</div>
        </div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if trends %}
  <header class="cat" id="trends">
    <div class="eyebrow">{{ trends|length }} {{ "trend" if trends|length == 1 else "trends" }} across recent weeks</div>
    <h2>What's building</h2>
    <p>Patterns that keep showing up, week after week.</p>
  </header>
  {% for t in trends %}
  <section class="trend" id="trend-{{ loop.index }}">
    <div class="eyebrow">{{ t.stories }} stories over {{ t.weeks }} weeks</div>
    <h3>{{ t.title }}</h3>
    <p>{{ t.body }}</p>
    <ul>{% for s in t.evidence %}<li><a href="{{ s.url }}">{{ s.title }}</a> <span>&middot; {{ s.source }}</span></li>{% endfor %}</ul>
  </section>
  {% endfor %}
  {% endif %}

  {% if brief.sections %}
  {% if legacy %}
  {% for section in brief.sections %}
  {% set sec = loop.index %}
  <header class="cat" id="s{{ sec }}">
    <div class="eyebrow">{{ section.entries|length }} {{ "story" if section.entries|length == 1 else "stories" }}</div>
    <h2>{{ section.title }}</h2>
    {% if section.description %}<p>{{ section.description }}</p>{% endif %}
  </header>
  {% for e in section.entries %}
  <article class="entry">
    <h3><a href="{{ e.url }}">{{ e.headline }}</a></h3>
    <p>{{ e.body }}</p>
    <a class="src" href="{{ e.url }}">{{ e.source }} &rarr;</a>
  </article>
  {% endfor %}
  {% endfor %}
  {% else %}
  <header class="cat" id="news">
    <div class="eyebrow">{{ brief.sections|sum(attribute="entries", start=[])|length }} stories</div>
    <h2>The news</h2>
  </header>
  <p class="news-index">{% for s in brief.sections %}<a href="#s{{ loop.index }}">{{ s.title }}</a> ({{ s.entries|length }}){% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
  {% for section in brief.sections %}
  <div class="group" id="s{{ loop.index }}">
    <div class="eyebrow">{{ section.title }}</div>
    {% for e in section.entries %}
    {% if e.takeaways %}
    <article class="lead-story" id="{{ e.anchor }}">
      {{ chips(e) }}
      <h3><a href="{{ e.url }}">{{ e.headline }}</a></h3>
      <p>{{ e.body }} <a class="src" href="{{ e.url }}">{{ e.source }}&nbsp;&rarr;</a></p>
    </article>
    {% else %}
    <div class="brief-item" id="{{ e.anchor }}">{% if e.follow_up %}<span class="chip">Update</span>{% endif %}<a href="{{ e.url }}">{{ e.headline }}{% if e.headline[-1:] not in '.?!' %}.{% endif %}</a> {{ e.body }} <a class="src" href="{{ e.url }}">{{ e.source }}&nbsp;&rarr;</a></div>
    {% endif %}
    {% endfor %}
  </div>
  {% endfor %}
  {% endif %}
  {% endif %}

  <nav class="pager" aria-label="More briefs">
    {% if older %}<a href="../{{ older.slug }}/">&larr; {{ older.subject }}</a>{% endif %}
    {% if newer %}<a class="next" href="../{{ newer.slug }}/">{{ newer.subject }} &rarr;</a>{% endif %}
  </nav>
</main>
{% endblock %}
