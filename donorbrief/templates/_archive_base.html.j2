{#- Public archive pages. Colors, type and spacing follow docs/STYLE.md. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}DonorBrief{% endblock %}</title>
<meta name="description" content="{% block description %}A weekly briefing on philanthropy, nonprofits and generosity research from the Institute on Generosity.{% endblock %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap" rel="stylesheet">
<style>
:root {
  --lime: #C7E263; --green: #42820F; --black: #000; --cream: #FBF8F2; --rule: #EBE7DF; --white: #FFF;
  --quiet: rgba(0,0,0,.62); --meta: rgba(0,0,0,.45);
  --font-display: Optima, 'Optima nova', Candara, 'Gill Sans', 'Segoe UI', sans-serif;
  --font-body: 'DM Sans', 'Segoe UI', Arial, sans-serif;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { background: var(--cream); color: var(--black); font-family: var(--font-body); font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
a { color: var(--green); text-decoration: none; }
a:hover { color: var(--black); text-decoration: underline; }
a:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
::selection { background: var(--lime); }
.wrap { max-width: 760px; margin: 0 auto; padding: 0 24px; }
.eyebrow { font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; line-height: 1.4; }
.topbar { background: var(--black); color: var(--cream); }
.topbar .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 58px; }
.topbar .eyebrow { color: var(--lime); }
.topbar .sub { font-size: 11.5px; color: rgba(251,248,242,.6); }
.topbar a { color: rgba(251,248,242,.72); font-size: 12.5px; }
.topbar a:hover { color: var(--cream); }
.hero { background: var(--lime); padding: 48px 0 40px; }
.tag { display: inline-block; background: var(--black); color: var(--lime); font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; padding: 4px 8px; border-radius: 3px; }
h1 { font-family: var(--font-display); font-weight: 400; font-size: 40px; line-height: 1.12; margin: 16px 0 12px; }
.hero p { margin: 0; max-width: 600px; font-size: 16.5px; }
.label { color: var(--green); padding-bottom: 8px; border-bottom: 1px solid var(--rule); margin: 40px 0 0; }
h2, h3 { font-family: var(--font-display); font-weight: 400; }
.meta { font-size: 12.5px; color: var(--meta); }
.footer { border-top: 1px solid var(--rule); margin-top: 56px; padding: 24px 0 48px; font-size: 12.5px; color: var(--quiet); }
@media (max-width: 600px) {
  .wrap { padding: 0 16px; }
  .hero { padding: 32px 0 28px; }
  h1 { font-size: 30px; }
  .topbar .sub { display: none; }
}
{% block style %}{% endblock %}
</style>
</head>
<body>
<header class="topbar">
  <div class="wrap">
    <div>
      <div class="eyebrow">Institute on Generosity</div>
      <div class="sub">DonorBrief &middot; weekly briefing</div>
    </div>
    {% block nav %}{% endblock %}
  </div>
</header>
{% block content %}{% endblock %}
<footer class="wrap footer">
  DonorBrief is AI-drafted from public sources and reviewed by Institute on Generosity staff before sending.
</footer>
</body>
</html>
