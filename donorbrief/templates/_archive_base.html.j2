{#- Public archive pages. Colors, type and spacing follow docs/STYLE.md. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}DonorBrief{% endblock %}</title>
<meta name="description" content="{% block description %}A weekly briefing on philanthropy, nonprofits and generosity research from the Institute on Generosity.{% endblock %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap" rel="stylesheet">
<style>
:root {
  --blue: #00BFFF; --dark-blue: #324ECD; --red: #FF2C00; --black: #000; --gray: #F1F5F9; --rule: #DCE3EB; --white: #FFF;
  --quiet: rgba(0,0,0,.62); --meta: rgba(0,0,0,.45);
  --font-display: Optima, 'Optima nova', Candara, 'Gill Sans', 'Segoe UI', sans-serif;
  --font-body: 'DM Sans', 'Segoe UI', Arial, sans-serif;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { background: var(--gray); color: var(--black); font-family: var(--font-body); font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
a { color: var(--dark-blue); text-decoration: none; }
a:hover { color: var(--black); text-decoration: underline; }
a:focus-visible { outline: 2px solid var(--dark-blue); outline-offset: 2px; }
::selection { background: var(--blue); }
.wrap { max-width: 760px; margin: 0 auto; padding-left: max(24px, env(safe-area-inset-left, 0px)); padding-right: max(24px, env(safe-area-inset-right, 0px)); }
.eyebrow { font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; line-height: 1.4; }
.topbar { background: var(--black); color: var(--white); }
.topbar .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 58px; padding-top: 12px; padding-bottom: 12px; }
.topbar .logo { display: block; height: 28px; width: auto; margin: 0 0 4px; }
.topbar .sub { font-size: 11.5px; color: rgba(255,255,255,.6); }
.topbar a { color: rgba(255,255,255,.72); font-size: 12.5px; }
.topbar a:hover { color: var(--white); }
.hero { background: var(--blue); padding: 48px 0 40px; }
.tag { display: inline-block; background: var(--black); color: var(--blue); font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; padding: 4px 8px; border-radius: 3px; }
h1 { font-family: var(--font-display); font-weight: 400; font-size: 40px; line-height: 1.12; margin: 16px 0 12px; }
.hero p { margin: 0; max-width: 600px; font-size: 16.5px; }
.label { color: var(--dark-blue); padding-bottom: 8px; border-bottom: 1px solid var(--rule); margin: 40px 0 0; }
h2, h3 { font-family: var(--font-display); font-weight: 400; }
.meta { font-size: 12.5px; color: var(--meta); }
.footer { border-top: 1px solid var(--rule); margin-top: 56px; padding: 24px 0 48px; font-size: 12.5px; color: var(--quiet); }
@media (max-width: 600px) {
  .wrap { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .hero { padding: 32px 0 28px; }
  h1 { font-size: 30px; }
  .topbar .sub { display: none; }
}
{% block style %}{% endblock %}
</style>
</head>
